options:
  parameters:
    author: Antenna benchmark
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ber_curve_bpsk
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: BPSK BER vs Eb/N0 | stock blocks
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1640
    - 8
    rotation: 0
    state: enabled
blocks:
- name: const
  id: variable_constellation
  parameters:
    comment: ''
    const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    type: bpsk
  states:
    coordinate:
    - 136
    - 128
    rotation: 0
    state: enabled
- name: k
  id: variable
  parameters:
    comment: ''
    value: const.bits_per_symbol()
  states:
    coordinate:
    - 16
    - 128
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    coordinate:
    - 1344
    - 56
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    coordinate:
    - 376
    - 128
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: ''
    value: '32'
  states:
    coordinate:
    - 440
    - 128
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(nfilts, nfilts*sps, 1.0, alpha, 11*sps*nfilts)
  states:
    coordinate:
    - 496
    - 128
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: symbol_rate*sps
  states:
    coordinate:
    - 1392
    - 56
    rotation: 0
    state: enabled
- name: symbol_rate
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Symbol rate (symbols/s)
    short_id: ''
    type: eng_float
    value: 1e6
  states:
    coordinate:
    - 1224
    - 56
    rotation: 0
    state: enabled
- name: bit_rate
  id: variable
  parameters:
    comment: ''
    value: symbol_rate*k
  states:
    coordinate:
    - 1504
    - 56
    rotation: 0
    state: enabled
- name: symbol_rms
  id: variable
  parameters:
    comment: ''
    value: (sum(abs(p)**2 for p in const.points())/len(const.points()))**0.5
  states:
    coordinate:
    - 256
    - 128
    rotation: 0
    state: enabled
- name: timing_bw
  id: variable
  parameters:
    comment: ''
    value: '0.0628'
  states:
    coordinate:
    - 672
    - 128
    rotation: 0
    state: enabled
- name: eq_algorithm
  id: variable_adaptive_algorithm
  parameters:
    comment: ''
    cons: const
    delta: '10.0'
    ffactor: '0.99'
    modulus: '2'
    step_size: eq_step/(eq_taps*symbol_rms**2)
    type: lms
  states:
    coordinate:
    - 1064
    - 128
    rotation: 0
    state: enabled
- name: eq_taps
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Adaptive equalizer taps
    short_id: ''
    type: intx
    value: '11'
  states:
    coordinate:
    - 736
    - 128
    rotation: 0
    state: enabled
- name: eq_step
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: NLMS adaptation step
    short_id: ''
    type: eng_float
    value: '0.01'
  states:
    coordinate:
    - 848
    - 128
    rotation: 0
    state: enabled
- name: eq_delay_symbols
  id: variable
  parameters:
    comment: ''
    value: (eq_taps-1)//2
  states:
    coordinate:
    - 968
    - 128
    rotation: 0
    state: enabled
- name: reference_delay
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: TX reference delay (bits)
    short_id: ''
    type: intx
    value: '34'
  states:
    coordinate:
    - 1216
    - 128
    rotation: 0
    state: enabled
- name: warmup_bits
  id: variable
  parameters:
    comment: ''
    value: '50000'
  states:
    coordinate:
    - 1328
    - 128
    rotation: 0
    state: enabled
- name: tx_power_dbm
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: TX average conducted power (dBm)
    short_id: ''
    type: eng_float
    value: '0'
  states:
    coordinate:
    - 744
    - 56
    rotation: 0
    state: enabled
- name: tx_amplitude
  id: variable
  parameters:
    comment: ''
    value: 10**(tx_power_dbm/20.0)
  states:
    coordinate:
    - 864
    - 56
    rotation: 0
    state: enabled
- name: path_loss_db
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Net path loss including gains/losses (dB)
    short_id: ''
    type: eng_float
    value: '0'
  states:
    coordinate:
    - 984
    - 56
    rotation: 0
    state: enabled
- name: path_gain
  id: variable
  parameters:
    comment: ''
    value: 10**(-path_loss_db/20.0)
  states:
    coordinate:
    - 1104
    - 56
    rotation: 0
    state: enabled
- name: chart_math
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: 'import math

      import numpy'
  states:
    coordinate:
    - 1400
    - 128
    rotation: 0
    state: enabled
- name: ebno_db
  id: variable
  parameters:
    value: '[0, 2, 4, 6, 8, 10, 12, 14]'
  states:
    coordinate:
    - 16
    - 56
    rotation: 0
    state: enabled
- name: noise_volts
  id: variable
  parameters:
    value: list(tx_amplitude*path_gain*10**(-(numpy.array(ebno_db) - 10*math.log10(samp_rate/bit_rate))/20))
  states:
    coordinate:
    - 560
    - 56
    rotation: 0
    state: enabled
- name: min_errors
  id: parameter
  parameters:
    value: '100'
    type: intx
    label: Bit errors to collect per point
    short_id: ''
    hide: none
  states:
    coordinate:
    - 120
    - 56
    rotation: 0
    state: enabled
- name: ber_floor_log10
  id: parameter
  parameters:
    value: '-7'
    type: eng_float
    label: Stop a point below BER 10^x
    short_id: ''
    hide: none
  states:
    coordinate:
    - 224
    - 56
    rotation: 0
    state: enabled
- name: plot_update_s
  id: parameter
  parameters:
    value: '0.5'
    type: eng_float
    label: Plot refresh interval (s)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 456
    - 56
    rotation: 0
    state: enabled
- name: sim_speed
  id: parameter
  parameters:
    value: '100'
    type: eng_float
    label: Simulation speed limit (x real time)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 344
    - 56
    rotation: 0
    state: enabled
- name: section_controls
  id: note
  parameters:
    note: 'CONTROLS: EB/N0 POINTS AND MODEM'
  states:
    coordinate:
    - 16
    - 8
    rotation: 0
    state: enabled
- name: section_transmitter
