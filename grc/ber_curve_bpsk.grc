- name: equalizer_initial_taps
  id: snippet
  parameters:
    section: main_after_init
    priority: '0'
    code: "# Start every row's adaptive equalizer at a centered identity filter.\nfor i in range(8):\n    getattr(self,\
      \ 'equalizer_%d' % i).set_taps([0j]*((self.eq_taps-1)//2)+[1+0j]+[0j]*(self.eq_taps//2))"
  states:
    coordinate:
    - 16
    - 200
    rotation: 0
    state: enabled
- name: curve_title
  id: snippet
  parameters:
    section: main_after_init
    priority: '0'
    code: 'self.ber_curve.set_title(''BPSK BER vs Eb/N0 (x axis: Eb/N0 in dB per bit). Red: BPSK/QPSK theory'')

      self.resize(1000, 700)'
  states:
    coordinate:
    - 168
    - 200
    rotation: 0
    state: enabled
