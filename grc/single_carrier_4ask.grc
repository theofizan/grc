options:
  parameters:
    id: single_carrier_4ask
    title: 4ASK single carrier | stock blocks
    generate_options: qt_gui
    output_language: python
    author: Antenna benchmark
  states:
    coordinate:
    - 16
    - 12
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: symbol_rate*sps
  states:
    coordinate:
    - 328
    - 88
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    value: '4'
  states:
    coordinate:
    - 280
    - 88
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    value: '0.35'
  states:
    coordinate:
    - 544
    - 88
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    value: '32'
  states:
    coordinate:
    - 608
    - 88
    rotation: 0
    state: enabled
- name: timing_bw
  id: variable
  parameters:
    value: '0.0628'
  states:
    coordinate:
    - 664
    - 88
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    value: firdes.root_raised_cosine(nfilts, nfilts*sps, 1.0, alpha, 11*sps*nfilts)
  states:
    coordinate:
    - 728
    - 88
    rotation: 0
    state: enabled
- name: const
  id: variable_constellation_rect
  parameters:
    sym_map: '[0, 1, 2, 3]'
    const_points: '[-3, -1, 1, 3]'
    rot_sym: '1'
    real_sect: '4'
    imag_sect: '1'
    w_real_sect: '2'
    w_imag_sect: '1'
  states:
    coordinate:
    - 160
    - 360
    rotation: 0
    state: enabled
- name: reference_delay
  id: parameter
  parameters:
    value: '68'
    type: intx
    label: TX reference delay (bits)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 160
    - 288
    rotation: 0
    state: enabled
- name: ber_window
  id: variable
  parameters:
    value: '10000'
  states:
    coordinate:
    - 272
    - 288
    rotation: 0
    state: enabled
- name: warmup_bits
  id: variable
  parameters:
    value: '4096'
  states:
    coordinate:
    - 344
    - 288
    rotation: 0
    state: enabled
- name: k
  id: variable
  parameters:
    value: const.bits_per_symbol()
  states:
    coordinate:
    - 1096
    - 232
    rotation: 0
    state: enabled
- name: symbol_rate
  id: parameter
  parameters:
    value: 1e6
    type: eng_float
    label: Symbol rate (symbols/s)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 160
    - 88
    rotation: 0
    state: enabled
- name: bit_rate
  id: variable
  parameters:
    value: symbol_rate*k
  states:
    coordinate:
    - 440
    - 88
    rotation: 0
    state: enabled
- name: rrc_bandwidth
  id: variable
  parameters:
    value: symbol_rate*(1+alpha)
  states:
    coordinate:
    - 1088
    - 88
    rotation: 0
    state: enabled
- name: random_bytes
  id: analog_random_source_x
  parameters:
    type: byte
    min: '0'
    max: '256'
    num_samps: '32768'
    repeat: 'True'
  states:
    coordinate:
    - 16
    - 584
    rotation: 0
    state: enabled
- name: modulator
  id: digital_constellation_modulator
  parameters:
    constellation: const
    differential: 'True'
    samples_per_symbol: sps
    excess_bw: alpha
    truncate: 'False'
  states:
    coordinate:
    - 144
    - 584
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle2
  parameters:
    type: complex
    samples_per_second: samp_rate
    vlen: '1'
    ignoretag: 'True'
    limit: auto
  states:
    coordinate:
    - 504
    - 584
    rotation: 0
    state: enabled
- name: channel
  id: channels_channel_model
  parameters:
    noise_voltage: noise_volt
    freq_offset: '0'
    epsilon: '1'
    taps: '[path_gain/(1+channel_echo**2)**0.5]+[0j]*(sps-1)+[path_gain*channel_echo/(1+channel_echo**2)**0.5]'
    seed: '42'
    block_tags: 'False'
  states:
    coordinate:
    - 648
    - 584
    rotation: 0
    state: enabled
- name: clock_sync
  id: digital_pfb_clock_sync_xxx
  parameters:
    type: ccf
    sps: sps
    loop_bw: timing_bw
    taps: rrc_taps
    filter_size: nfilts
    init_phase: '16'
    max_dev: '1.5'
    osps: '1'
  states:
    coordinate:
    - 992
    - 584
    rotation: 0
    state: enabled
- name: decoder
  id: digital_constellation_decoder_cb
  parameters:
    constellation: const
  states:
    coordinate:
    - 1464
    - 584
    rotation: 0
    state: enabled
- name: decoded_link
  id: virtual_sink
  parameters:
    stream_id: decoded
  states:
    coordinate:
    - 1632
    - 584
    rotation: 0
    state: enabled
- name: reference_link
  id: virtual_sink
  parameters:
    stream_id: reference
  states:
    coordinate:
    - 16
    - 684
    rotation: 0
    state: enabled
- name: decoded_source
  id: virtual_source
  parameters:
    stream_id: decoded
  states:
    coordinate:
    - 16
    - 954
    rotation: 0
    state: enabled
- name: diff_decoder
  id: digital_diff_decoder_bb
  parameters:
    modulus: '4'
    coding: digital.DIFF_DIFFERENTIAL
  states:
    coordinate:
    - 152
    - 952.0
    rotation: 0
    state: enabled
- name: unpack_rx
  id: blocks_unpack_k_bits_bb
  parameters:
    k: k
  states:
    coordinate:
    - 330
    - 954
    rotation: 0
    state: enabled
- name: skip_rx
  id: blocks_skiphead
  parameters:
    type: byte
    vlen: '1'
    num_items: warmup_bits
  states:
    coordinate:
    - 480
    - 954
    rotation: 0
    state: enabled
- name: reference_source
  id: virtual_source
  parameters:
    stream_id: reference
  states:
    coordinate:
    - 16
    - 1094
    rotation: 0
    state: enabled
- name: unpack_tx
  id: blocks_unpack_k_bits_bb
  parameters:
    k: '8'
  states:
    coordinate:
    - 150
    - 1094
    rotation: 0
    state: enabled
- name: delay
  id: blocks_delay
  parameters:
    type: byte
    vlen: '1'
    delay: reference_delay
  states:
    coordinate:
    - 330
    - 1094
    rotation: 0
    state: enabled
- name: skip_tx
  id: blocks_skiphead
  parameters:
    type: byte
    vlen: '1'
    num_items: warmup_bits
  states:
    coordinate:
    - 480
    - 1094
    rotation: 0
    state: enabled
- name: xor
  id: blocks_xor_xx
  parameters:
    type: byte
    num_inputs: '2'
  states:
    coordinate:
    - 680
    - 1004
    rotation: 0
    state: enabled
- name: errors_float
  id: blocks_uchar_to_float
  parameters: {}
  states:
    coordinate:
    - 760
    - 1004
    rotation: 0
    state: enabled
- name: integrate
  id: blocks_integrate_xx
  parameters:
    type: float
    decim: ber_window
    vlen: '1'
  states:
    coordinate:
    - 910
    - 1004
    rotation: 0
    state: enabled
- name: ber_scale
  id: blocks_multiply_const_vxx
  parameters:
    type: float
    const: 1.0/ber_window
    vlen: '1'
  states:
    coordinate:
    - 1070
    - 1004
    rotation: 0
    state: enabled
- name: ber_display
  id: qtgui_number_sink
  parameters:
    type: float
    name: BER | latest 10000 compared bits
    nconnections: '1'
    autoscale: 'False'
    avg: '0'
    graph_type: qtgui.NUM_GRAPH_NONE
    min: '0'
    max: '1'
    label1: Bit error ratio
    unit1: errors/bit
    gui_hint: views@0:0,0,1,1
  states:
    coordinate:
    - 1240
    - 1004
    rotation: 0
    state: enabled
- name: constellation
  id: qtgui_const_sink_x
  parameters:
    type: complex
    name: After adaptive LMS equalization | symbols and guides
    size: '1024'
    nconnections: '3'
    grid: 'True'
    autoscale: 'False'
    xmin: '-2'
    xmax: '2'
    ymin: '-2'
    ymax: '2'
    gui_hint: views@0:2,0,1,1
    label1: RX symbols
    label2: Ideal reference
    label3: EVM radius guide (% RMS)
    color1: '"blue"'
    color2: '"black"'
    color3: '"dark green"'
    marker1: '0'
    marker2: '8'
    marker3: '0'
    style1: '0'
    style2: '0'
    style3: '0'
    alpha1: '0.3'
    alpha2: '1.0'
    alpha3: '0.5'
  states:
    coordinate:
    - 160
    - 1324
    rotation: 0
    state: enabled
- name: spectrum
  id: qtgui_freq_sink_x
  parameters:
