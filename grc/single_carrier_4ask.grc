    rotation: 0
    state: enabled
- name: scope
  id: note
  parameters:
    note: 'SISO single carrier, RRC pulse shaping. 4ASK, 4 samples/symbol. No carrier recovery: leave frequency
      offset=0 and epsilon=1 for scored BER. Delay calibrated for this filter/clock configuration. See README.md.'
  states:
    coordinate:
    - 16
    - 2084
    rotation: 0
    state: enabled
- name: rx_iq_link
