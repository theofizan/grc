options:
  parameters:
    id: ber_curve_8ask
    title: 8-ASK BER vs Eb/N0 | stock blocks
    generate_options: qt_gui
    output_language: python
    author: Antenna benchmark
  states:
    coordinate:
    - 1640
    - 8
    rotation: 0
    state: enabled
blocks:
- name: const
  id: variable_constellation_rect
  parameters:
    sym_map: '[0, 1, 2, 3, 4, 5, 6, 7]'
    const_points: '[-7, -5, -3, -1, 1, 3, 5, 7]'
    rot_sym: '1'
    real_sect: '8'
    imag_sect: '1'
    w_real_sect: '2'
    w_imag_sect: '1'
  states:
    coordinate:
    - 136
    - 128
    rotation: 0
    state: enabled
- name: k
  id: variable
  parameters:
    value: const.bits_per_symbol()
  states:
    coordinate:
    - 16
    - 128
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    value: '4'
  states:
    coordinate:
    - 1248
    - 56
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    value: '0.35'
  states:
    coordinate:
    - 400
    - 128
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    value: '32'
  states:
    coordinate:
    - 464
    - 128
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    value: firdes.root_raised_cosine(nfilts, nfilts*sps, 1.0, alpha, 11*sps*nfilts)
  states:
    coordinate:
    - 520
    - 128
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    value: symbol_rate*sps
  states:
    coordinate:
    - 1296
    - 56
    rotation: 0
    state: enabled
- name: symbol_rate
  id: parameter
  parameters:
    value: 1e6
    type: eng_float
    label: Symbol rate (symbols/s)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 1128
    - 56
    rotation: 0
    state: enabled
- name: bit_rate
  id: variable
  parameters:
    value: symbol_rate*k
  states:
    coordinate:
    - 1408
    - 56
    rotation: 0
    state: enabled
- name: symbol_rms
  id: variable
  parameters:
    value: (sum(abs(p)**2 for p in const.points())/len(const.points()))**0.5
  states:
    coordinate:
    - 256
    - 128
    rotation: 0
    state: enabled
- name: timing_bw
  id: variable
  parameters:
    value: '0.0628'
  states:
    coordinate:
    - 696
    - 128
    rotation: 0
    state: enabled
- name: eq_algorithm
  id: variable_adaptive_algorithm
  parameters:
    type: lms
    cons: const
    step_size: eq_step/(eq_taps*symbol_rms**2)
  states:
    coordinate:
    - 1088
    - 128
    rotation: 0
    state: enabled
- name: eq_taps
  id: parameter
  parameters:
    value: '11'
    type: intx
    label: Adaptive equalizer taps
    short_id: ''
    hide: none
  states:
    coordinate:
    - 760
    - 128
    rotation: 0
    state: enabled
- name: eq_step
  id: parameter
  parameters:
    value: '0.01'
    type: eng_float
    label: NLMS adaptation step
    short_id: ''
    hide: none
  states:
    coordinate:
    - 872
    - 128
    rotation: 0
    state: enabled
- name: eq_delay_symbols
  id: variable
  parameters:
    value: (eq_taps-1)//2
  states:
    coordinate:
    - 992
    - 128
    rotation: 0
    state: enabled
- name: reference_delay
  id: parameter
  parameters:
    value: '102'
    type: intx
    label: TX reference delay (bits)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 1240
    - 128
    rotation: 0
    state: enabled
- name: warmup_bits
  id: variable
  parameters:
    value: '50000'
  states:
    coordinate:
    - 1352
    - 128
    rotation: 0
    state: enabled
- name: tx_power_dbm
  id: parameter
  parameters:
    value: '0'
    type: eng_float
    label: TX average conducted power (dBm)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 648
    - 56
    rotation: 0
    state: enabled
- name: tx_amplitude
  id: variable
  parameters:
    value: 10**(tx_power_dbm/20.0)
  states:
    coordinate:
    - 768
    - 56
    rotation: 0
    state: enabled
- name: path_loss_db
  id: parameter
  parameters:
    value: '0'
    type: eng_float
    label: Net path loss including gains/losses (dB)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 888
    - 56
    rotation: 0
    state: enabled
- name: path_gain
  id: variable
  parameters:
    value: 10**(-path_loss_db/20.0)
  states:
    coordinate:
    - 1008
    - 56
    rotation: 0
    state: enabled
- name: chart_math
  id: import
  parameters:
    imports: 'import math

      import numpy'
  states:
    coordinate:
    - 1424
    - 128
    rotation: 0
    state: enabled
- name: ebno_db
  id: variable
  parameters:
    value: '[6, 8, 10, 12, 14, 16, 18, 20]'
  states:
    coordinate:
    - 16
    - 56
    rotation: 0
    state: enabled
- name: noise_volts
  id: variable
  parameters:
    value: list(tx_amplitude*path_gain*10**(-(numpy.array(ebno_db) - 10*math.log10(samp_rate/bit_rate))/20))
  states:
    coordinate:
    - 464
    - 56
    rotation: 0
    state: enabled
- name: min_errors
  id: parameter
  parameters:
    value: '100'
    type: intx
    label: Bit errors to collect per point
    short_id: ''
    hide: none
  states:
    coordinate:
    - 128
    - 56
    rotation: 0
    state: enabled
- name: ber_floor_log10
  id: parameter
  parameters:
    value: '-7'
    type: eng_float
    label: Stop a point below BER 10^x
    short_id: ''
    hide: none
  states:
    coordinate:
    - 232
    - 56
    rotation: 0
    state: enabled
- name: sim_speed
  id: parameter
  parameters:
    value: '100'
    type: eng_float
    label: Simulation speed limit (x real time)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 352
    - 56
    rotation: 0
    state: enabled
- name: section_controls
  id: note
  parameters:
    note: 'CONTROLS: EB/N0 POINTS AND MODEM'
  states:
    coordinate:
    - 16
    - 8
    rotation: 0
    state: enabled
- name: section_transmitter
  id: note
  parameters:
    note: TRANSMITTER
  states:
    coordinate:
    - 16
    - 336
    rotation: 0
    state: enabled
- name: random_bytes
  id: analog_random_source_x
  parameters:
    type: byte
    min: '0'
    max: '256'
    num_samps: '32768'
    repeat: 'True'
  states:
    coordinate:
    - 16
    - 386
    rotation: 0
    state: enabled
- name: modulator
  id: digital_constellation_modulator
  parameters:
    constellation: const
    differential: 'True'
    samples_per_symbol: sps
    excess_bw: alpha
    truncate: 'False'
  states:
    coordinate:
    - 246
    - 386
    rotation: 0
    state: enabled
- name: tx_power
  id: blocks_multiply_const_vxx
  parameters:
    type: complex
    const: tx_amplitude/symbol_rms
    vlen: '1'
  states:
    coordinate:
    - 476
    - 386
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle2
  parameters:
    type: complex
    samples_per_second: samp_rate*sim_speed
    vlen: '1'
    ignoretag: 'True'
    limit: auto
  states:
    coordinate:
    - 706
    - 386
    rotation: 0
    state: enabled
- name: tx_link
  id: virtual_sink
  parameters:
    stream_id: tx_waveform
  states:
    coordinate:
    - 936
    - 386
    rotation: 0
    state: enabled
- name: reference_link
  id: virtual_sink
  parameters:
    stream_id: tx_bytes
  states:
    coordinate:
    - 230
    - 476
    rotation: 0
    state: enabled
- name: reference_source
  id: virtual_source
  parameters:
    stream_id: tx_bytes
  states:
    coordinate:
    - 16
    - 566
    rotation: 0
    state: enabled
- name: unpack_tx
  id: blocks_unpack_k_bits_bb
  parameters:
    k: '8'
  states:
    coordinate:
    - 200
    - 566
    rotation: 0
    state: enabled
- name: delay
  id: blocks_delay
  parameters:
    type: byte
    vlen: '1'
    delay: reference_delay
  states:
    coordinate:
    - 400
    - 566
    rotation: 0
    state: enabled
- name: skip_tx
  id: blocks_skiphead
  parameters:
    type: byte
    vlen: '1'
    num_items: warmup_bits
  states:
    coordinate:
    - 600
    - 566
    rotation: 0
    state: enabled
- name: pack_tx
  id: blocks_pack_k_bits_bb
  parameters:
    k: '8'
  states:
    coordinate:
    - 800
    - 566
    rotation: 0
    state: enabled
- name: tx_bits_link
  id: virtual_sink
  parameters:
    stream_id: tx_reference_bytes
  states:
    coordinate:
    - 980
    - 566
    rotation: 0
    state: enabled
- name: section_receivers
  id: note
  parameters:
    note: CHANNEL AND RECEIVER, ONE ROW PER EB/N0 POINT
  states:
    coordinate:
    - 16
    - 656
    rotation: 0
    state: enabled
- name: tx_in_0
  id: virtual_source
  parameters:
    stream_id: tx_waveform
  states:
    coordinate:
    - 16
    - 706
    rotation: 0
    state: enabled
- name: channel_0
  id: channels_channel_model
  parameters:
    noise_voltage: noise_volts[0]
    freq_offset: '0'
    epsilon: '1'
    taps: '[path_gain]'
    seed: '100'
    block_tags: 'False'
  states:
    coordinate:
    - 170
    - 706
    rotation: 0
    state: enabled
- name: rx_level_0
  id: blocks_multiply_const_vxx
  parameters:
    type: complex
    const: 1.0/(tx_amplitude*path_gain)
    vlen: '1'
  states:
    coordinate:
    - 400
    - 706
    rotation: 0
    state: enabled
- name: clock_sync_0
  id: digital_pfb_clock_sync_xxx
  parameters:
    type: ccf
    sps: sps
    loop_bw: timing_bw
    taps: rrc_taps
    filter_size: nfilts
    init_phase: '16'
    max_dev: '1.5'
    osps: '1'
  states:
    coordinate:
    - 600
    - 706
    rotation: 0
    state: enabled
- name: rx_scale_0
  id: blocks_multiply_const_vxx
  parameters:
    type: complex
    const: symbol_rms
    vlen: '1'
  states:
    coordinate:
    - 800
    - 706
    rotation: 0
    state: enabled
- name: equalizer_0
  id: digital_linear_equalizer
  parameters:
    num_taps: eq_taps
    sps: '1'
    alg: eq_algorithm
    adapt_after_training: 'True'
    training_sequence: '[]'
    training_start_tag: ''
  states:
    coordinate:
    - 1000
    - 706
    rotation: 0
    state: enabled
- name: decoder_0
  id: digital_constellation_decoder_cb
  parameters:
    constellation: const
  states:
    coordinate:
    - 1200
    - 706
    rotation: 0
    state: enabled
- name: diff_decoder_0
