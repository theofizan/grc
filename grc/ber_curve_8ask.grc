    priority: '0'
    code: 'self.ber_curve.set_title(''8-ASK BER vs Eb/N0 (x axis: Eb/N0 in dB per bit). Red: BPSK/QPSK theory'')

      self.resize(1000, 700)'
  states:
    coordinate:
    - 168
    - 248
    rotation: 0
    state: enabled
