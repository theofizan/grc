    nconnections: '3'
    grid: 'True'
    autoscale: 'False'
    xmin: '-2'
    xmax: '2'
    ymin: '-2'
    ymax: '2'
    gui_hint: views@0:2,0,1,1
    label1: RX symbols
    label2: Ideal reference
    label3: EVM radius guide (% RMS)
