- name: link_table
  id: snippet
  parameters:
    section: main_after_init
    priority: '1'
    code: "# Link budget and BER test as a spreadsheet-style table (display only).\n# Values come from stock Probe\
      \ Signal blocks; edit rows here to change it.\nrows = [\n    ('Transmit', 'Average power', self.probe_tx_dbm,\
      \ 'dBm', 'dB'),\n    ('', 'Sampled peak power', self.probe_tx_peak_dbm, 'dBm', 'dB'),\n    ('', 'Peak / average',\
      \ self.probe_tx_papr, 'dB', 'dB'),\n    ('Receive', 'Signal + noise power', self.probe_rx_dbm, 'dBm', 'dB'),\n\
      \    ('', 'SNR (noise over Fs)', self.probe_rx_snr, 'dB', 'dB'),\n    ('', 'Eb/N0 per uncoded bit', self.probe_rx_ebno,\
      \ 'dB', 'dB'),\n    ('', 'EVM (decision-directed)', self.probe_evm_rms, '%', 'dB'),\n    ('BER', 'Latest 10,000\
      \ bits', self.probe_ber_scale, 'errors/bit', 'ber'),\n    ('BER test', 'Test length', None, 'bits', \"f'{10000\
      \ * self.ber_test_blocks:,}'\"),\n    ('', 'Estimated time', None, 's', \"f'{self.ber_test_seconds:.2f}'\"\
      ),\n    ('', 'Status', self.probe_ber_test_count, '', 'status'),\n    ('', 'Bits compared', self.probe_ber_test_count,\
      \ 'bits', 'test_count'),\n    ('', 'Bit errors', self.probe_ber_test_errors, 'errors', 'test_errors'),\n \
      \   ('', 'BER', self.probe_ber_test_ratio, 'errors/bit', 'test_ber'),\n]\ntable = Qt.QTableWidget(len(rows),\
      \ 4)\ntable.setHorizontalHeaderLabels([\"Section\", \"Quantity\", \"Value\", \"Unit\"])\ntable.verticalHeader().setVisible(False)\n\
      table.setEditTriggers(Qt.QAbstractItemView.NoEditTriggers)\ntable.setSelectionMode(Qt.QAbstractItemView.NoSelection)\n\
      table.setAlternatingRowColors(True)\ntable.setShowGrid(True)\nbold = Qt.QFont(table.font())\nbold.setBold(True)\n\
      for row, (section, quantity, probe, unit, fmt) in enumerate(rows):\n    for column, text in ((0, section),\
      \ (1, quantity), (3, unit)):\n        item = Qt.QTableWidgetItem(text)\n        if column == 0:\n        \
      \    item.setFont(bold)\n        table.setItem(row, column, item)\n    value = Qt.QTableWidgetItem(\"\" if\
      \ probe else str(eval(fmt)))\n    value.setTextAlignment(Qt.Qt.AlignRight | Qt.Qt.AlignVCenter)\n    table.setItem(row,\
      \ 2, value)\nheader = table.horizontalHeader()\nheader.setSectionResizeMode(Qt.QHeaderView.ResizeToContents)\n\
      header.setStretchLastSection(True)\ntest_bits = 10000 * self.ber_test_blocks\n# BER test totals run since\
      \ the flowchart started; each test is shown relative\n# to the totals frozen when it began (zero for the first\
      \ test).\ntest = dict(base_count=0.0, base_errors=0.0, restarting=False)\n\ndef test_values():\n    count\
      \ = self.probe_ber_test_count.level() - test[\"base_count\"]\n    errors = self.probe_ber_test_errors.level()\
      \ - test[\"base_errors\"]\n    return count, errors\n\ndef refresh_link_table():\n    count, errors = test_values()\n\
      \    for row, (section, quantity, probe, unit, fmt) in enumerate(rows):\n        if probe is None:\n     \
      \       continue\n        level = probe.level()\n        if fmt == \"dB\":\n            text = f\"{level:.2f}\"\
      \n        elif fmt == \"count\":\n            text = f\"{level:,.0f}\"\n        elif fmt == \"ber\":\n   \
      \         text = f\"{level:.3e}\"\n        elif fmt == \"test_count\":\n            text = f\"{count:,.0f}\"\
      \n        elif fmt == \"test_errors\":\n            text = f\"{errors:,.0f}\"\n        elif fmt == \"test_ber\"\
      :\n            text = f\"{errors / count:.3e}\" if count > 0 else \"\"\n        elif test[\"restarting\"]:\n\
      \            text = \"restarting\"\n        else:\n            text = \"complete\" if count >= test_bits else\
      \ (\n                \"counting\" if count > 0 else \"waiting for warm-up\")\n        table.item(row, 2).setText(text)\n\
      \ndef restart_ber_test():\n    # 1) Close the test gate so the running totals freeze.\n    test[\"restarting\"\
      ] = True\n    self.set_ber_test_start(1e15)\n    Qt.QTimer.singleShot(500, begin_new_test)\n\ndef begin_new_test():\n\
      \    # 2) Frozen totals become the new zero; the new test starts a quarter\n    #    second ahead, so every\
      \ counted 10,000-bit window is new and the test\n    #    covers exactly ber_test_bits bits.\n    test[\"\
      base_count\"] = self.probe_ber_test_count.level()\n    test[\"base_errors\"] = self.probe_ber_test_errors.level()\n\
      \    ahead = max(2, int(0.25 * self.bit_rate / 10000))\n    self.set_ber_test_start(self.probe_ber_test_index.level()\
      \ + ahead)\n    test[\"restarting\"] = False\n\nself.restart_ber_test = restart_ber_test\nself.restart_ber_test_button\
      \ = Qt.QPushButton(\"Restart BER test\")\nself.restart_ber_test_button.clicked.connect(restart_ber_test)\n\
      self.views_grid_layout_3.addWidget(self.restart_ber_test_button, 4, 0, 1, 2)\n\nself.link_table = table\n\
      self.link_table_timer = Qt.QTimer()\nself.link_table_timer.timeout.connect(refresh_link_table)\nself.link_table_timer.start(int(1000\
      \ * self.plot_update_s))\nself.views_grid_layout_3.addWidget(table, 1, 0, 2, 1)\n"
  states:
    coordinate:
    - 680
    - 248
    rotation: 0
    state: enabled
