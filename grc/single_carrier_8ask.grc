    const: 1.0/ber_window
    vlen: '1'
  states:
    coordinate:
    - 952
    - 736
    rotation: 0
    state: enabled
- name: ber_display
  id: qtgui_number_sink
  parameters:
    type: float
    name: BER | latest 10000 compared bits
    nconnections: '1'
    autoscale: 'False'
    avg: '0'
    graph_type: qtgui.NUM_GRAPH_NONE
    min: '0'
    max: '1'
    label1: Bit error ratio
    unit1: errors/bit
    gui_hint: views@0:0,0,1,1
    update_time: plot_update_s
  states:
    coordinate:
    - 1120
    - 736
    rotation: 0
    state: enabled
- name: constellation
  id: qtgui_const_sink_x
  parameters:
    type: complex
