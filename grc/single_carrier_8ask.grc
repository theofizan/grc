    coordinate:
    - 16
    - 792
    rotation: 0
    state: enabled
- name: unpack_tx
  id: blocks_unpack_k_bits_bb
  parameters:
    k: '8'
  states:
    coordinate:
    - 144
    - 800
    rotation: 0
    state: enabled
- name: delay
  id: blocks_delay
  parameters:
    type: byte
    vlen: '1'
    delay: reference_delay
  states:
    coordinate:
    - 280
    - 792
    rotation: 0
    state: enabled
- name: skip_tx
  id: blocks_skiphead
  parameters:
    type: byte
    vlen: '1'
    num_items: warmup_bits
  states:
    coordinate:
    - 432
    - 792
    rotation: 0
    state: enabled
- name: xor
  id: blocks_xor_xx
  parameters:
    type: byte
    num_inputs: '2'
  states:
    coordinate:
    - 600
    - 736
    rotation: 0
    state: enabled
- name: errors_float
  id: blocks_uchar_to_float
  parameters: {}
  states:
    coordinate:
    - 672
    - 736
    rotation: 0
    state: enabled
- name: integrate
  id: blocks_integrate_xx
  parameters:
    type: float
    decim: ber_window
    vlen: '1'
  states:
    coordinate:
    - 792
    - 736
    rotation: 0
    state: enabled
- name: ber_scale
  id: blocks_multiply_const_vxx
  parameters:
