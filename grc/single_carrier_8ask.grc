options:
  parameters:
    id: single_carrier_8ask
    title: 8ASK single carrier | stock blocks
    generate_options: qt_gui
    output_language: python
    author: Antenna benchmark
  states:
    coordinate:
    - 2480
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: symbol_rate*sps
  states:
    coordinate:
    - 184
    - 56
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    value: '4'
  states:
    coordinate:
    - 136
    - 56
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    value: '0.35'
  states:
    coordinate:
    - 400
    - 56
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    value: '32'
  states:
    coordinate:
    - 464
    - 56
    rotation: 0
    state: enabled
- name: timing_bw
  id: variable
  parameters:
    value: '0.0628'
  states:
    coordinate:
    - 520
    - 56
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    value: firdes.root_raised_cosine(nfilts, nfilts*sps, 1.0, alpha, 11*sps*nfilts)
  states:
    coordinate:
    - 584
    - 56
    rotation: 0
    state: enabled
- name: const
  id: variable_constellation_rect
  parameters:
    sym_map: '[0, 1, 2, 3, 4, 5, 6, 7]'
    const_points: '[-7, -5, -3, -1, 1, 3, 5, 7]'
    rot_sym: '1'
    real_sect: '8'
    imag_sect: '1'
    w_real_sect: '2'
    w_imag_sect: '1'
  states:
    coordinate:
    - 1280
    - 128
    rotation: 0
    state: enabled
- name: reference_delay
  id: parameter
  parameters:
    value: '102'
    type: intx
    label: TX reference delay (bits)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 576
    - 128
    rotation: 0
    state: enabled
- name: ber_window
  id: variable
  parameters:
    value: '10000'
  states:
    coordinate:
    - 688
    - 128
    rotation: 0
    state: enabled
- name: warmup_bits
  id: variable
  parameters:
    value: '4096'
  states:
    coordinate:
    - 760
    - 128
    rotation: 0
    state: enabled
- name: k
  id: variable
  parameters:
    value: const.bits_per_symbol()
  states:
    coordinate:
    - 312
    - 128
    rotation: 0
    state: enabled
- name: symbol_rate
  id: parameter
  parameters:
    value: 1e6
    type: eng_float
    label: Symbol rate (symbols/s)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 16
    - 56
    rotation: 0
    state: enabled
- name: bit_rate
  id: variable
  parameters:
    value: symbol_rate*k
  states:
    coordinate:
    - 296
    - 56
    rotation: 0
    state: enabled
- name: rrc_bandwidth
  id: variable
  parameters:
    value: symbol_rate*(1+alpha)
  states:
    coordinate:
    - 944
    - 56
    rotation: 0
    state: enabled
- name: random_bytes
  id: analog_random_source_x
  parameters:
    type: byte
    min: '0'
    max: '256'
    num_samps: '32768'
    repeat: 'True'
  states:
    coordinate:
    - 16
    - 432
    rotation: 0
    state: enabled
- name: modulator
  id: digital_constellation_modulator
  parameters:
    constellation: const
    differential: 'True'
    samples_per_symbol: sps
    excess_bw: alpha
    truncate: 'False'
  states:
    coordinate:
    - 160
    - 432
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle2
  parameters:
    type: complex
    samples_per_second: samp_rate
    vlen: '1'
    ignoretag: 'True'
    limit: auto
  states:
    coordinate:
    - 552
    - 432
    rotation: 0
    state: enabled
- name: channel
  id: channels_channel_model
  parameters:
    noise_voltage: noise_volt
    freq_offset: '0'
    epsilon: '1'
    taps: '[path_gain/(1+channel_echo**2)**0.5]+[0j]*(sps-1)+[path_gain*channel_echo/(1+channel_echo**2)**0.5]'
    seed: '42'
    block_tags: 'False'
  states:
    coordinate:
    - 712
    - 432
    rotation: 0
    state: enabled
- name: clock_sync
  id: digital_pfb_clock_sync_xxx
  parameters:
    type: ccf
    sps: sps
    loop_bw: timing_bw
    taps: rrc_taps
    filter_size: nfilts
    init_phase: '16'
    max_dev: '1.5'
    osps: '1'
  states:
    coordinate:
    - 1088
    - 432
    rotation: 0
    state: enabled
- name: decoder
  id: digital_constellation_decoder_cb
  parameters:
    constellation: const
  states:
    coordinate:
    - 1608
    - 432
    rotation: 0
    state: enabled
- name: decoded_link
