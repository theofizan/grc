options:
  parameters:
    id: wlan_reference_channel
    title: 'Legacy Wi-Fi reference: finite IQ AWGN replay'
    author: Antenna benchmark project
    description: Replay actual MATLAB-generated non-HT PPDU samples. See docs/FLOWGRAPHS.md for export and analysis.
    generate_options: no_gui
    output_language: python
    run_options: run
    catch_exceptions: 'True'
    run: 'True'
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: project_imports
  id: import
  parameters:
    imports: 'from antenna_bench.paths import ROOT

      from antenna_bench.math import make_symbols

      import math'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 12
    rotation: 0
    state: enabled
- name: rate_index
  id: parameter
  parameters:
    value: '2'
    type: intx
    label: Legacy rate index (0-7)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 90
    rotation: 0
    state: enabled
- name: snr_db
  id: parameter
  parameters:
    value: '25'
    type: eng_float
    label: Active DATA sample SNR (dB)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 90
    rotation: 0
    state: enabled
- name: sample_rate
  id: variable
  parameters:
    value: 20e6
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 640
    - 90
    rotation: 0
    state: enabled
- name: tx_file
  id: variable
  parameters:
    value: str(ROOT / ('results/reference/wlan_rate_%d_tx.c64' % rate_index))
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 180
    rotation: 0
    state: enabled
- name: noise_voltage
  id: variable
  parameters:
    value: math.sqrt(__import__('json').loads((ROOT / ('results/reference/wlan_rate_%d.json' % rate_index)).read_text())['active_time_power']/10**(snr_db/10))
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 640
    - 180
    rotation: 0
    state: enabled
- name: wifi_reference
  id: blocks_file_source
  parameters:
    type: complex
    file: tx_file
    repeat: 'False'
    vlen: '1'
    begin_tag: pmt.PMT_NIL
    offset: '0'
    length: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 320
    rotation: 0
    state: enabled
- name: complex_awgn
  id: analog_noise_source_x
  parameters:
    type: complex
    noise_type: analog.GR_GAUSSIAN
    amp: noise_voltage
    seed: '20261017'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 450
    rotation: 0
    state: enabled
- name: add_noise
  id: blocks_add_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 350
    rotation: 0
    state: enabled
- name: wifi_capture
  id: blocks_file_sink
  parameters:
    type: complex
    file: str(ROOT / ('results/grc/wlan_rate_%d_rx.c64' % rate_index))
    append: 'False'
    vlen: '1'
    unbuffered: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 900
    - 350
    rotation: 0
    state: enabled
- name: scope
  id: note
  parameters:
    note: WLAN TOOLBOX REFERENCE PPDU -> GNU RADIO AWGN -> RAW IQ. No packet/coding approximation.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 570
    rotation: 0
    state: enabled
- name: axis
  id: note
  parameters:
    note: snr_db is active-DATA time-sample SNR, not EbNo. Idle samples are excluded from signal-power calibration.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 610
    rotation: 0
    state: enabled
- name: analysis
  id: note
  parameters:
    note: 'Offline Python: known-schedule pre-FEC BER/EVM. MATLAB: independent equalizer, decoder and post-FEC BER.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 650
    rotation: 0
    state: enabled
connections:
- - wifi_reference
  - '0'
  - add_noise
  - '0'
- - complex_awgn
  - '0'
  - add_noise
  - '1'
- - add_noise
  - '0'
  - wifi_capture
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
