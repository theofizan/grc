options:
  parameters:
    id: siso_wlan_lab
    title: 'SISO Wi-Fi PHY: waveform -> FIR/CFO/AWGN -> trained RX -> BER/EVM'
    author: Antenna benchmark project
    description: Complete known-burst SISO PHY with fixed active TX power and live pre-FEC BER/EVM. No autonomous
      acquisition or MAC.
    generate_options: qt_gui
    output_language: python
    run_options: run
    catch_exceptions: 'True'
    run: 'True'
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: project_imports
  id: import
  parameters:
    imports: 'import math

      import numpy as np

      from antenna_bench.paths import ROOT

      from antenna_bench.live import test_bits, wlan_reference, burst_waveform, reference_symbols, parse_taps

      from antenna_bench.wlan import wlan_constellation

      from gnuradio import digital'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 10
    rotation: 0
    state: enabled
- name: rate_index
  id: parameter
  parameters:
    value: '2'
    type: intx
    label: Legacy rate index (0-7)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 100
    rotation: 0
    state: enabled
- name: snr_db
  id: parameter
  parameters:
    value: '25'
    type: eng_float
    label: TX active-PPDU reference SNR (dB)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 100
    rotation: 0
    state: enabled
- name: path_loss_db
  id: parameter
  parameters:
    value: '0'
    type: eng_float
    label: SISO power loss (dB)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 100
    rotation: 0
    state: enabled
- name: packet_count
  id: parameter
  parameters:
    value: '0'
    type: intx
    label: PHY bursts (0 = continuous)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 860
    - 100
    rotation: 0
    state: enabled
- name: pace
  id: parameter
  parameters:
    value: '1000000'
    type: eng_float
    label: Playback samples per wall-clock second
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1070
    - 100
    rotation: 0
    state: enabled
- name: cfo_hz
  id: parameter
  parameters:
    value: '0'
    type: eng_float
    label: Carrier offset (Hz)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 200
    rotation: 0
    state: enabled
- name: channel_taps
  id: parameter
  parameters:
    value: 1+0j
    type: str
    label: Causal SISO FIR taps
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 200
    rotation: 0
    state: enabled
- name: correct_cfo
  id: parameter
  parameters:
    value: '1'
    type: intx
    label: STF/LTF CFO correction (0/1)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 100
    rotation: 0
    state: enabled
- name: pilot_tracking
  id: parameter
  parameters:
    value: '1'
    type: intx
    label: Pilot phase correction (0/1)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 200
    rotation: 0
    state: enabled
- name: reference
  id: variable
  parameters:
    value: wlan_reference(rate_index)
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 200
    rotation: 0
    state: enabled
- name: sample_rate
  id: variable
  parameters:
    value: 20e6
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 860
    - 200
    rotation: 0
    state: enabled
- name: order
  id: variable
  parameters:
    value: int(reference['order'])
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1070
    - 200
    rotation: 0
    state: enabled
- name: k
  id: variable
  parameters:
    value: int(math.log2(order))
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 290
    rotation: 0
    state: enabled
- name: channel_gain
  id: variable
  parameters:
    value: 10**(-path_loss_db/20)
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 290
    rotation: 0
    state: enabled
- name: noise_voltage
  id: variable
  parameters:
    value: 10**(-snr_db/20)
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 290
    rotation: 0
    state: enabled
- name: constellation_object
  id: variable
  parameters:
    value: digital.constellation_calcdist(wlan_constellation(order).tolist(),list(range(order)),1,1,digital.constellation.NO_NORMALIZATION).base()
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 860
    - 290
    rotation: 0
    state: enabled
- name: tx_waveform
  id: blocks_vector_source_x
  parameters:
    type: complex
    vector: burst_waveform(rate_index).tolist()
    repeat: 'True'
    vlen: '1'
    tags: '[]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 410
    rotation: 0
    state: enabled
- name: finite_tx
  id: blocks_head
  parameters:
    type: complex
    num_items: packet_count*len(burst_waveform(rate_index)) if packet_count>0 else 2**60
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 410
    rotation: 0
    state: enabled
- name: pace_tx
  id: blocks_throttle2
  parameters:
    type: complex
    samples_per_second: pace
    vlen: '1'
    ignoretag: 'True'
    limit: auto
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 410
    rotation: 0
    state: enabled
- name: siso_fir
  id: fir_filter_xxx
  parameters:
    type: ccc
    decim: '1'
    taps: '[channel_gain*t for t in parse_taps(channel_taps)]'
    samp_delay: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 570
    rotation: 0
    state: enabled
- name: carrier_offset
  id: blocks_rotator_cc
  parameters:
    phase_inc: 2*math.pi*cfo_hz/sample_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 570
    rotation: 0
    state: enabled
- name: awgn
  id: analog_noise_source_x
  parameters:
    type: complex
    noise_type: analog.GR_GAUSSIAN
    amp: noise_voltage
    seed: '20261017'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 710
    rotation: 0
    state: enabled
- name: channel_output
  id: blocks_add_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 570
    rotation: 0
    state: enabled
- name: extract_bursts
  id: blocks_keep_m_in_n
  parameters:
    type: complex
    m: reference['tx_packet'].size
    n: len(burst_waveform(rate_index))
    offset: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 850
    rotation: 0
    state: enabled
- name: burst_receiver
  id: epy_block
  parameters:
    _source_code: "import antenna_bench.gr_metrics as metrics\n\nclass blk(metrics.BurstReceiver):\n    def __init__(self,\
      \ rate_index=2, correct_cfo=True, pilot_tracking=True, report_path=\"\"):\n        super().__init__(rate_index,\
      \ correct_cfo, pilot_tracking, report_path)\n"
    rate_index: rate_index
    correct_cfo: bool(correct_cfo)
    pilot_tracking: bool(pilot_tracking)
    report_path: str(ROOT / 'results/live/siso_wlan_receiver.json')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 550
    - 850
    rotation: 0
    state: enabled
- name: demap
  id: digital_constellation_decoder_cb
  parameters:
    constellation: constellation_object
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 1040
    rotation: 0
    state: enabled
- name: rx_bits
  id: blocks_unpack_k_bits_bb
  parameters:
    k: k
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 1040
    rotation: 0
    state: enabled
- name: tx_reference
  id: blocks_vector_source_x
  parameters:
    type: complex
    vector: reference_symbols(rate_index).tolist()
    repeat: 'True'
    vlen: '1'
    tags: '[]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 1210
    rotation: 0
    state: enabled
- name: finite_reference
  id: blocks_head
  parameters:
    type: complex
    num_items: packet_count*reference_symbols(rate_index).size if packet_count>0 else 2**60
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 1210
    rotation: 0
    state: enabled
- name: tx_decisions
  id: digital_constellation_decoder_cb
  parameters:
    constellation: constellation_object
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 800
    - 1210
    rotation: 0
    state: enabled
- name: tx_bits
  id: blocks_unpack_k_bits_bb
  parameters:
    k: k
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1100
    - 1210
    rotation: 0
    state: enabled
- name: ber_meter
  id: epy_block
  parameters:
    _source_code: "import antenna_bench.gr_metrics as metrics\n\nclass blk(metrics.BitErrorMeter):\n    def __init__(self,\
      \ report_path=\"\", run_config=None):\n        super().__init__(report_path, run_config)\n"
    report_path: str(ROOT / 'results/live/siso_wlan_ber.json')
    run_config: dict(model='SISO known-burst Wi-Fi',rate_index=rate_index,tx_reference_snr_db=snr_db,path_loss_db=path_loss_db,cfo_hz=cfo_hz,channel_taps=channel_taps,correct_cfo=correct_cfo,pilot_tracking=pilot_tracking)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1100
    - 1040
    rotation: 0
    state: enabled
- name: evm_meter
  id: epy_block
  parameters:
    _source_code: "import antenna_bench.gr_metrics as metrics\n\nclass blk(metrics.EvmMeter):\n    def __init__(self,\
      \ report_path=\"\", run_config=None):\n        super().__init__(report_path, run_config)\n"
    report_path: str(ROOT / 'results/live/siso_wlan_evm.json')
    run_config: dict(model='SISO known-burst Wi-Fi',rate_index=rate_index,tx_reference_snr_db=snr_db,path_loss_db=path_loss_db,cfo_hz=cfo_hz,channel_taps=channel_taps,correct_cfo=correct_cfo,pilot_tracking=pilot_tracking)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1100
    - 1180
    rotation: 0
    state: enabled
- name: views
  id: qtgui_tab_widget
  parameters:
    num_tabs: '3'
    label0: Metrics and constellation
    label1: 'TX waveform: spectrum / waterfall / time'
    label2: 'RX waveform: spectrum / waterfall / time'
    label3: Equalized DATA symbols
    label4: TX reference symbols
    gui_hint: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 1440
    rotation: 0
    state: enabled
- name: tx_scope
  id: qtgui_sink_x
  parameters:
    type: complex
    name: TX waveform | complex baseband; relative FFT level
    fftsize: '1024'
    wintype: window.WIN_HANN
    fc: '0'
    bw: sample_rate
    rate: '5'
    plotfreq: 'True'
    plotwaterfall: 'True'
    plottime: 'True'
    plotconst: 'False'
    showrf: 'False'
    gui_hint: views@1:0,0,1,2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 1550
    rotation: 0
    state: enabled
- name: rx_scope
  id: qtgui_sink_x
  parameters:
    type: complex
    name: RX waveform | before equalization; relative FFT level
    fftsize: '1024'
    wintype: window.WIN_HANN
    fc: '0'
    bw: sample_rate
    rate: '5'
    plotfreq: 'True'
    plotwaterfall: 'True'
    plottime: 'True'
    plotconst: 'False'
    showrf: 'False'
    gui_hint: views@2:0,0,1,2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 1660
    rotation: 0
    state: enabled
- name: constellation
  id: qtgui_const_sink_x
  parameters:
    type: complex
    name: SISO equalized symbols and known reference
    size: '1024'
    grid: 'True'
    autoscale: 'False'
    xmin: '-2.0'
    xmax: '2.0'
    ymin: '-2.0'
    ymax: '2.0'
    nconnections: '2'
    label1: RX equalized DATA
    label2: TX reference DATA
    color1: '"blue"'
    color2: '"red"'
    style1: '0'
    style2: '0'
    marker1: '0'
    marker2: '8'
    alpha1: '0.5'
    alpha2: '1.0'
    gui_hint: views@0:1,0,1,2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 850
    - 1540
    rotation: 0
    state: enabled
- name: ber_display
  id: qtgui_number_sink
  parameters:
    type: float
    name: Cumulative pre-FEC BER
    autoscale: 'False'
    avg: '0'
    graph_type: qtgui.NUM_GRAPH_NONE
    nconnections: '1'
    min: '0'
    max: '1'
    label1: Cumulative pre-FEC BER
    unit1: errors/bit
    gui_hint: views@0:0,0,1,1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 1990
    rotation: 0
    state: enabled
- name: evm_display
  id: qtgui_number_sink
  parameters:
    type: float
    name: Pooled RMS EVM
    autoscale: 'False'
    avg: '0'
    graph_type: qtgui.NUM_GRAPH_NONE
    nconnections: '1'
    min: '0'
    max: '100'
    label1: Pooled RMS EVM
    unit1: '%'
    gui_hint: views@0:0,1,1,1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 900
    - 1990
    rotation: 0
    state: enabled
- name: scope
  id: note
  parameters:
    note: 'SISO LEGACY Wi-Fi PHY LAB: 1 TX / 1 RX; fixed rate/length and known burst schedule. No MAC, ACK or retries.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 2150
    rotation: 0
    state: enabled
- name: power
  id: note
  parameters:
    note: TX active-PPDU mean |x|^2=1 at every rate; snr_db sets fixed noise power against that TX reference, not
      measured RX SNR.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 2190
    rotation: 0
    state: enabled
- name: receiver_note
  id: note
  parameters:
    note: Receiver contains STF/LTF CFO correction, LTF-only ZF, CP removal/FFT and pilot phase tracking. Double-click
      Python block; see docs/SISO_LABS.md.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 2230
    rotation: 0
    state: enabled
- name: pacing
  id: note
  parameters:
    note: Logical sample rate=20 Msps. pace controls wall-clock playback only. packet_count=0 is continuous. Stop
      saves BER/EVM and receiver JSON.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 2270
    rotation: 0
    state: enabled
connections:
- - tx_waveform
  - '0'
  - finite_tx
  - '0'
- - finite_tx
  - '0'
  - pace_tx
  - '0'
- - pace_tx
  - '0'
  - siso_fir
  - '0'
- - siso_fir
  - '0'
  - carrier_offset
  - '0'
- - carrier_offset
  - '0'
  - channel_output
  - '0'
- - awgn
  - '0'
  - channel_output
  - '1'
- - channel_output
  - '0'
  - extract_bursts
  - '0'
- - extract_bursts
  - '0'
  - burst_receiver
  - '0'
- - burst_receiver
  - '0'
  - demap
  - '0'
- - demap
  - '0'
  - rx_bits
  - '0'
- - tx_reference
  - '0'
  - finite_reference
  - '0'
- - finite_reference
  - '0'
  - tx_decisions
  - '0'
- - tx_decisions
  - '0'
  - tx_bits
  - '0'
- - tx_bits
  - '0'
  - ber_meter
  - '0'
- - rx_bits
  - '0'
  - ber_meter
  - '1'
- - finite_reference
  - '0'
  - evm_meter
  - '0'
- - burst_receiver
  - '0'
  - evm_meter
  - '1'
- - pace_tx
  - '0'
  - tx_scope
  - '0'
- - channel_output
  - '0'
  - rx_scope
  - '0'
- - burst_receiver
  - '0'
  - constellation
  - '0'
- - finite_reference
  - '0'
