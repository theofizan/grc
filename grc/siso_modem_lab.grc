    bus_source: false
    bus_structure: null
    coordinate: [230, 1050]
    rotation: 0
    state: enabled

connections:
- [awgn, '0', channel_output, '1']
- [ber_meter, '0', ber_display, '0']
- [channel_output, '0', equalize, '0']
- [channel_output, '0', rx_scope, '0']
- [demap, '0', rx_bits, '0']
- [equalize, '0', constellation, '0']
- [equalize, '0', demap, '0']
- [equalize, '0', evm_meter, '1']
- [evm_meter, '0', evm_display, '0']
- [finite_bits, '0', ber_meter, '0']
- [finite_bits, '0', pack_bits, '0']
- [known_bits, '0', finite_bits, '0']
- [mapper, '0', constellation, '1']
- [mapper, '0', evm_meter, '0']
- [mapper, '0', pace_tx, '0']
- [pace_tx, '0', siso_path, '0']
- [pace_tx, '0', tx_scope, '0']
- [pack_bits, '0', mapper, '0']
- [rx_bits, '0', ber_meter, '1']
- [siso_path, '0', channel_output, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
