options:
  parameters:
    author: Antenna benchmark project
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Complete uncoded symbol-rate SISO chain, ideal scalar receiver, live
      BER/EVM and Qt plots.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: siso_modem_lab
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'SISO modem: bits -> modulation -> channel -> decisions -> BER/EVM'
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: channel_gain
  id: variable
  parameters:
    comment: ''
    value: 10**(-path_loss_db/20)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 200]
    rotation: 0
    state: enabled
- name: constellation_object
  id: variable
  parameters:
    comment: ''
    value: digital.constellation_calcdist(wlan_constellation(order).tolist(),list(range(order)),1,1,digital.constellation.NO_NORMALIZATION).base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [860, 200]
    rotation: 0
    state: enabled
- name: k
  id: variable
  parameters:
    comment: ''
    value: int(math.log2(order))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 200]
    rotation: 0
    state: enabled
- name: noise_voltage
  id: variable
  parameters:
    comment: ''
    value: math.sqrt(1/(k*10**(ebno_db/10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [650, 200]
    rotation: 0
    state: enabled
- name: awgn
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_voltage
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '20261017'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [510, 630]
    rotation: 0
    state: enabled
- name: ber_display
  id: qtgui_number_sink
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    avg: '0'
    color1: ("black", "black")
    color10: ("black", "black")
    color2: ("black", "black")
    color3: ("black", "black")
    color4: ("black", "black")
    color5: ("black", "black")
    color6: ("black", "black")
    color7: ("black", "black")
    color8: ("black", "black")
    color9: ("black", "black")
    comment: ''
    factor1: '1'
    factor10: '1'
    factor2: '1'
    factor3: '1'
    factor4: '1'
    factor5: '1'
    factor6: '1'
    factor7: '1'
    factor8: '1'
    factor9: '1'
    graph_type: qtgui.NUM_GRAPH_NONE
    gui_hint: views@0:0,0,1,1
    label1: Cumulative pre-FEC BER
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    max: '1'
    min: '0'
    name: Cumulative pre-FEC BER
    nconnections: '1'
    type: float
    unit1: errors/bit
    unit10: ''
    unit2: ''
    unit3: ''
    unit4: ''
    unit5: ''
    unit6: ''
    unit7: ''
    unit8: ''
    unit9: ''
    update_time: '0.10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 1600]
    rotation: 0
    state: enabled
- name: ber_meter
  id: epy_block
  parameters:
    _source_code: "import antenna_bench.gr_metrics as metrics\n\nclass blk(metrics.BitErrorMeter):\n\
      \    def __init__(self, report_path=\"\", run_config=None):\n        super().__init__(report_path,\
      \ run_config)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    report_path: str(ROOT / 'results/live/siso_modem_ber.json')
    run_config: dict(model='SISO symbol-rate',order=order,ebno_db=ebno_db,path_loss_db=path_loss_db)
  states:
    _io_cache: ('SISO cumulative BER (TX bits vs RX bits)', 'blk', [('report_path',
      "''"), ('run_config', 'None')], [('0', 'byte', 1), ('1', 'byte', 1)], [('0',
      'float', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 780]
    rotation: 0
    state: enabled
- name: channel_output
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [790, 490]
    rotation: 0
    state: enabled
- name: constellation
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '0.5'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    grid: 'True'
    gui_hint: views@0:1,0,1,2
    label1: RX equalized DATA
    label10: ''
    label2: TX reference DATA
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '0'
    marker10: '0'
    marker2: '8'
    marker3: '0'
    marker4: '0'
    marker5: '0'
    marker6: '0'
    marker7: '0'
    marker8: '0'
    marker9: '0'
    name: SISO equalized symbols and known reference
    nconnections: '2'
    size: '1024'
    style1: '0'
    style10: '0'
    style2: '0'
    style3: '0'
    style4: '0'
    style5: '0'
    style6: '0'
    style7: '0'
    style8: '0'
    style9: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    xmax: '2.0'
    xmin: '-2.0'
    ymax: '2.0'
    ymin: '-2.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [850, 1150]
    rotation: 0
    state: enabled
- name: demap
  id: digital_constellation_decoder_cb
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    constellation: constellation_object
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 780]
    rotation: 0
    state: enabled
- name: ebno_db
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: TX-reference uncoded Eb/N0 (dB)
    short_id: ''
    type: eng_float
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 100]
    rotation: 0
    state: enabled
- name: equalize
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: 1/channel_gain
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1060, 490]
    rotation: 0
    state: enabled
- name: evm_display
  id: qtgui_number_sink
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    avg: '0'
    color1: ("black", "black")
    color10: ("black", "black")
    color2: ("black", "black")
    color3: ("black", "black")
    color4: ("black", "black")
    color5: ("black", "black")
    color6: ("black", "black")
    color7: ("black", "black")
    color8: ("black", "black")
    color9: ("black", "black")
    comment: ''
    factor1: '1'
    factor10: '1'
    factor2: '1'
    factor3: '1'
    factor4: '1'
    factor5: '1'
    factor6: '1'
    factor7: '1'
    factor8: '1'
    factor9: '1'
    graph_type: qtgui.NUM_GRAPH_NONE
    gui_hint: views@0:0,1,1,1
    label1: Pooled RMS EVM
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    max: '100'
    min: '0'
    name: Pooled RMS EVM
    nconnections: '1'
    type: float
    unit1: '%'
    unit10: ''
    unit2: ''
    unit3: ''
    unit4: ''
    unit5: ''
    unit6: ''
    unit7: ''
    unit8: ''
    unit9: ''
    update_time: '0.10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 1600]
    rotation: 0
    state: enabled
- name: evm_meter
  id: epy_block
  parameters:
    _source_code: "import antenna_bench.gr_metrics as metrics\n\nclass blk(metrics.EvmMeter):\n\
      \    def __init__(self, report_path=\"\", run_config=None):\n        super().__init__(report_path,\
      \ run_config)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    report_path: str(ROOT / 'results/live/siso_modem_evm.json')
    run_config: dict(model='SISO symbol-rate',order=order,ebno_db=ebno_db,path_loss_db=path_loss_db)
  states:
    _io_cache: ('SISO reference EVM (%)', 'blk', [('report_path', "''"), ('run_config',
      'None')], [('0', 'complex', 1), ('1', 'complex', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 920]
    rotation: 0
    state: enabled
- name: finite_bits
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: symbol_count*k if symbol_count>0 else 2**60
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 330]
    rotation: 0
    state: enabled
- name: known_bits
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: byte
    vector: test_bits(order).tolist()
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 330]
    rotation: 0
    state: enabled
- name: mapper
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    dimension: '1'
    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: complex
    symbol_table: wlan_constellation(order).tolist()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 330]
    rotation: 0
    state: enabled
- name: order
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Constellation order M
    short_id: ''
    type: intx
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 100]
    rotation: 0
    state: enabled
- name: pace
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Playback samples per wall-clock second
    short_id: ''
    type: eng_float
    value: '200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1070, 100]
    rotation: 0
    state: enabled
- name: pace_tx
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: pace
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 490]
    rotation: 0
    state: enabled
- name: pack_bits
  id: blocks_pack_k_bits_bb
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    k: k
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [770, 330]
    rotation: 0
    state: enabled
- name: path_loss_db
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: SISO power loss (dB)
    short_id: ''
    type: eng_float
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [650, 100]
    rotation: 0
    state: enabled
- name: power
  id: note
  parameters:
    alias: ''
    comment: ''
    note: Fixed TX Es=1; path loss reduces received SNR. AWGN is fixed relative to
      TX Eb/N0; it does NOT follow path loss.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 1800]
    rotation: 0
    state: enabled
- name: project_imports
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: 'import math

      import numpy as np

      from antenna_bench.paths import ROOT

      from antenna_bench.live import test_bits, wlan_reference, burst_waveform, reference_symbols,
      parse_taps

      from antenna_bench.wlan import wlan_constellation

      from gnuradio import digital'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 10]
    rotation: 0
    state: enabled
- name: rx_bits
  id: blocks_unpack_k_bits_bb
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    k: k
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 780]
    rotation: 0
    state: enabled
- name: rx_scope
  id: qtgui_sink_x
  parameters:
    affinity: ''
    alias: ''
    bw: pace
    comment: ''
    fc: '0'
    fftsize: '1024'
    gui_hint: views@2:0,0,1,2
    maxoutbuf: '0'
    minoutbuf: '0'
    name: RX waveform | before equalization; relative FFT level
    plotconst: 'False'
    plotfreq: 'True'
    plottime: 'True'
    plotwaterfall: 'True'
    rate: '5'
    showports: 'False'
    showrf: 'False'
    type: complex
    wintype: window.WIN_HANN
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 1270]
    rotation: 0
    state: enabled
- name: scope
  id: note
  parameters:
    alias: ''
    comment: ''
    note: 'SISO UNCODED SYMBOL LAB: 1 TX / 1 RX. Perfect timing, known scalar channel.
      Symbol-rate diagnostic, no RF pulse shaping.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 1760]
    rotation: 0
    state: enabled
- name: siso_path
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: channel_gain
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [510, 490]
    rotation: 0
    state: enabled
- name: symbol_count
  id: parameter
  parameters:
    alias: ''
