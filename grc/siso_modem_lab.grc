  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [860, 100]
    rotation: 0
    state: enabled
- name: tx_scope
  id: qtgui_sink_x
  parameters:
    affinity: ''
    alias: ''
    bw: pace
    comment: ''
    fc: '0'
    fftsize: '1024'
    gui_hint: views@1:0,0,1,2
    maxoutbuf: '0'
    minoutbuf: '0'
