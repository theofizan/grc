- name: use
  id: note
  parameters:
    alias: ''
    comment: ''
    note: symbol_count=0 runs until Stop (F7). Set >0 for finite checks. Stop writes
      exact BER counts / EVM JSON under results/live/.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 1840]
    rotation: 0
    state: enabled
- name: views
  id: qtgui_tab_widget
  parameters:
    alias: ''
    comment: ''
    gui_hint: ''
    label0: Metrics and constellation
    label1: 'TX waveform: spectrum / waterfall / time'
    label10: Tab 10
    label11: Tab 11
    label12: Tab 12
    label13: Tab 13
    label14: Tab 14
    label15: Tab 15
    label16: Tab 16
    label17: Tab 17
    label18: Tab 18
    label19: Tab 19
    label2: 'RX waveform: spectrum / waterfall / time'
    label3: Equalized DATA symbols
    label4: TX reference symbols
    label5: Tab 5
    label6: Tab 6
    label7: Tab 7
    label8: Tab 8
    label9: Tab 9
    num_tabs: '3'
  states:
