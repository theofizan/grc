options:
  parameters:
    id: n210_qpsk
    title: QPSK over the air | two USRP N210s
    generate_options: qt_gui
    output_language: python
    author: Antenna benchmark
  states:
    coordinate:
    - 2480
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: symbol_rate*sps
  states:
    coordinate:
    - 184
    - 56
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    value: '4'
  states:
    coordinate:
    - 136
    - 56
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    value: '0.35'
  states:
    coordinate:
    - 400
    - 56
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    value: '32'
  states:
    coordinate:
    - 464
    - 56
    rotation: 0
    state: enabled
- name: timing_bw
  id: variable
  parameters:
    value: '0.0628'
  states:
    coordinate:
    - 520
    - 56
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    value: firdes.root_raised_cosine(nfilts, nfilts*sps, 1.0, alpha, 11*sps*nfilts)
  states:
    coordinate:
    - 584
    - 56
    rotation: 0
    state: enabled
- name: const
  id: variable_constellation
  parameters:
    type: qpsk
  states:
    coordinate:
    - 2184
    - 56
    rotation: 0
    state: enabled
- name: ber_window
  id: variable
  parameters:
    value: '10000'
  states:
    coordinate:
    - 1592
    - 56
    rotation: 0
    state: enabled
- name: warmup_bits
  id: variable
  parameters:
    value: '4096'
  states:
    coordinate:
    - 1664
    - 56
    rotation: 0
    state: enabled
- name: k
  id: variable
  parameters:
    value: const.bits_per_symbol()
  states:
    coordinate:
    - 1352
    - 56
    rotation: 0
    state: enabled
- name: symbol_rate
  id: parameter
  parameters:
    value: 1e6
    type: eng_float
    label: Symbol rate (symbols/s)
    short_id: ''
    hide: none
  states:
    coordinate:
    - 16
    - 56
    rotation: 0
    state: enabled
- name: bit_rate
  id: variable
  parameters:
    value: symbol_rate*k
  states:
    coordinate:
    - 296
    - 56
    rotation: 0
    state: enabled
- name: rrc_bandwidth
  id: variable
  parameters:
    value: symbol_rate*(1+alpha)
  states:
    coordinate:
    - 944
    - 56
    rotation: 0
    state: enabled
- name: random_bytes
  id: blocks_vector_source_x
  parameters:
    type: byte
    vector: tx_data
    repeat: 'True'
    vlen: '1'
    tags: '[]'
  states:
    coordinate:
    - 16
    - 528
    rotation: 0
    state: enabled
- name: modulator
  id: digital_constellation_modulator
  parameters:
    constellation: const
    differential: 'False'
    samples_per_symbol: sps
    excess_bw: alpha
    truncate: 'False'
  states:
    coordinate:
    - 160
    - 528
    rotation: 0
    state: enabled
- name: clock_sync
  id: digital_pfb_clock_sync_xxx
  parameters:
    type: ccf
    sps: sps
    loop_bw: timing_bw
    taps: rrc_taps
    filter_size: nfilts
    init_phase: '16'
    max_dev: '0.05'
    osps: '1'
  states:
    coordinate:
    - 728
    - 736
    rotation: 0
    state: enabled
- name: decoder
  id: digital_constellation_decoder_cb
  parameters:
    constellation: const
  states:
    coordinate:
    - 1656
    - 736
    rotation: 0
    state: enabled
- name: decoded_link
  id: virtual_sink
  parameters:
    stream_id: decoded
  states:
    coordinate:
    - 1840
    - 736
    rotation: 0
    state: enabled
- name: reference_link
  id: virtual_sink
  parameters:
    stream_id: reference
  states:
    coordinate:
    - 160
    - 608
    rotation: 0
    state: enabled
- name: decoded_source
  id: virtual_source
  parameters:
    stream_id: decoded
  states:
    coordinate:
    - 16
    - 1136
    rotation: 0
    state: enabled
- name: unpack_rx
  id: blocks_unpack_k_bits_bb
  parameters:
    k: k
  states:
    coordinate:
    - 144
    - 1136
    rotation: 0
    state: enabled
- name: skip_rx
  id: blocks_skiphead
  parameters:
    type: byte
    vlen: '1'
    num_items: warmup_bits+2*data_period_bits+int(settle_s*bit_rate)
  states:
    coordinate:
    - 256
    - 1192
    rotation: 0
    state: enabled
- name: delay
  id: blocks_delay
  parameters:
    type: byte
    vlen: '1'
    delay: data_period_bits
  states:
    coordinate:
    - 256
    - 1136
    rotation: 0
    state: enabled
- name: skip_tx
  id: blocks_skiphead
  parameters:
    type: byte
    vlen: '1'
    num_items: warmup_bits+2*data_period_bits+int(settle_s*bit_rate)
  states:
    coordinate:
    - 456
    - 1136
    rotation: 0
    state: enabled
- name: xor
  id: blocks_xor_xx
  parameters:
    type: byte
    num_inputs: '2'
  states:
    coordinate:
    - 656
    - 1136
    rotation: 0
    state: enabled
- name: errors_float
  id: blocks_uchar_to_float
  parameters: {}
  states:
    coordinate:
    - 728
    - 1136
    rotation: 0
    state: enabled
- name: integrate
  id: blocks_integrate_xx
  parameters:
    type: float
    decim: ber_window
    vlen: '1'
  states:
    coordinate:
    - 848
    - 1136
    rotation: 0
    state: enabled
- name: ber_scale
  id: blocks_multiply_const_vxx
  parameters:
    type: float
    const: 0.5/ber_window
    vlen: '1'
  states:
    coordinate:
    - 1008
    - 1136
    rotation: 0
    state: enabled
- name: ber_display
  id: qtgui_number_sink
  parameters:
    type: float
    name: BER | RX vs RX one data period earlier, /2 (preamble-trained)
    nconnections: '1'
    autoscale: 'False'
    avg: '0'
    graph_type: qtgui.NUM_GRAPH_NONE
    min: '0'
    max: '1'
    label1: Bit error ratio
    unit1: errors/bit
    gui_hint: views@0:0,0,1,1
    update_time: plot_update_s
  states:
    coordinate:
    - 1168
    - 1136
    rotation: 0
    state: enabled
- name: constellation
  id: qtgui_const_sink_x
  parameters:
    type: complex
    name: After adaptive LMS equalization | symbols and guides
    size: '1024'
    nconnections: '3'
    grid: 'True'
    autoscale: 'False'
    xmin: '-2'
    xmax: '2'
    ymin: '-2'
    ymax: '2'
    gui_hint: views@0:2,0,1,1
    label1: RX symbols
    label2: Ideal reference
    label3: EVM radius guide (% RMS)
    color1: '"blue"'
    color2: '"black"'
    color3: '"dark green"'
    marker1: '0'
    marker2: '8'
    marker3: '0'
    style1: '0'
    style2: '0'
    style3: '0'
    alpha1: '0.3'
    alpha2: '1.0'
    alpha3: '0.5'
    update_time: plot_update_s
  states:
    coordinate:
    - 160
    - 2144
    rotation: 0
    state: enabled
- name: spectrum
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: TX and RX baseband spectrum | relative dB
    fftsize: '1024'
    wintype: window.WIN_HANN
    fc: '0'
    bw: samp_rate
    nconnections: '2'
    gui_hint: views@1:2,0,1,1
    label1: RX
    label2: TX
    update_time: plot_update_s
  states:
    coordinate:
    - 448
    - 2144
    rotation: 0
    state: enabled
- name: waveform
  id: qtgui_time_sink_x
  parameters:
    type: complex
    name: TX and RX waveform | I/Q
    size: '512'
    srate: samp_rate
    nconnections: '2'
    gui_hint: views@1:1,1,1,1
    label1: RX I
    label2: RX Q
    label3: TX I
    label4: TX Q
    update_time: plot_update_s
  states:
    coordinate:
    - 744
    - 2144
    rotation: 0
    state: enabled
- name: evm
  id: digital_meas_evm_cc
  parameters:
    cons: const
