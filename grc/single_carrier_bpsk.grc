- name: square_plot_panels
  id: snippet
  parameters:
    alias: ''
    code: "# Plot layout is a resizable 2x2 grid, not a square-canvas constraint.\nfor index in range(self.views.count()):\n\
      \    layout = getattr(self, \"views_grid_layout_\"+str(index))\n    if layout is not None:\n        layout.setColumnStretch(0,\
      \ 1)\n        layout.setColumnStretch(1, 1)\n        layout.setRowStretch(1, 1)\n        layout.setRowStretch(2,\
      \ 1)\n        # Native sinks otherwise request a large minimum and force scrolling.\n        for row in (1,\
      \ 2):\n            for column in (0, 1):\n                panel = layout.itemAtPosition(row, column).widget()\n\
      \                panel.setMinimumSize(0, 0)\n                panel.setSizePolicy(Qt.QSizePolicy.Ignored, Qt.QSizePolicy.Ignored)\n\
      self.views.setMinimumSize(0, 0)\nself.views.setSizePolicy(Qt.QSizePolicy.Ignored, Qt.QSizePolicy.Ignored)\n\
      self.resize(1180, 900)\n"
    comment: 'UI layout only: resizable 2x2 dashboards.'
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1696
    - 128
    rotation: 0
    state: enabled
