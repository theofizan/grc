options:
  parameters:
    author: Antenna benchmark
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: single_carrier_bpsk
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: BPSK single carrier | stock blocks
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2480
    - 8
    rotation: 0
    state: enabled
blocks:
- name: alpha
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 400
    - 56
    rotation: 0
    state: enabled
- name: ber_window
  id: variable
  parameters:
    comment: ''
    value: '10000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 664
    - 128
    rotation: 0
    state: enabled
- name: bit_rate
  id: variable
  parameters:
    comment: ''
    value: symbol_rate*k
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 296
    - 56
    rotation: 0
    state: enabled
- name: const
  id: variable_constellation
  parameters:
    comment: ''
    const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    type: bpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1256
    - 128
    rotation: 0
    state: enabled
- name: ebno_rx_db
  id: variable
  parameters:
    comment: ''
    value: snr_rx_db+10*math.log10(samp_rate/bit_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 128
    rotation: 0
    state: enabled
- name: eq_algorithm
  id: variable_adaptive_algorithm
  parameters:
    comment: ''
    cons: const
    delta: '10.0'
    ffactor: '0.99'
    modulus: '2'
    step_size: eq_step/(eq_taps*symbol_rms**2)
    type: lms
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1376
    - 128
    rotation: 0
    state: enabled
- name: eq_delay_symbols
  id: variable
  parameters:
    comment: ''
    value: (eq_taps-1)//2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 808
    - 128
    rotation: 0
    state: enabled
- name: esno_rx_db
  id: variable
  parameters:
    comment: ''
    value: snr_rx_db+10*math.log10(samp_rate/symbol_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 128
    rotation: 0
    state: enabled
- name: expected_rx_dbm
  id: variable
  parameters:
    comment: ''
    value: tx_power_dbm-path_loss_db
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1936
    - 56
    rotation: 0
    state: enabled
- name: eye_synthesis_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(sps,sps,1.0,alpha,11*sps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 56
    rotation: 0
    state: enabled
- name: k
  id: variable
  parameters:
    comment: ''
    value: const.bits_per_symbol()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 312
    - 128
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: ''
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 464
    - 56
    rotation: 0
    state: enabled
- name: noise_volt
  id: variable
  parameters:
    comment: ''
    value: 10**(rx_noise_dbm/20.0) if noise_enabled else 0.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2072
    - 56
    rotation: 0
    state: enabled
- name: path_gain
  id: variable
  parameters:
    comment: ''
    value: 10**(-path_loss_db/20.0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1800
    - 56
    rotation: 0
    state: enabled
- name: rrc_bandwidth
  id: variable
  parameters:
    comment: ''
    value: symbol_rate*(1+alpha)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 944
    - 56
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(nfilts, nfilts*sps, 1.0, alpha, 11*sps*nfilts)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 584
    - 56
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: symbol_rate*sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 184
    - 56
    rotation: 0
    state: enabled
- name: snr_rx_db
  id: variable
  parameters:
    comment: ''
    value: expected_rx_dbm-rx_noise_dbm if noise_enabled else float('inf')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2200
    - 56
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 136
    - 56
    rotation: 0
    state: enabled
- name: symbol_rms
  id: variable
  parameters:
    comment: ''
    value: (sum(abs(p)**2 for p in const.points())/len(const.points()))**0.5
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 432
    - 128
    rotation: 0
    state: enabled
- name: timing_bw
  id: variable
  parameters:
    comment: ''
    value: '0.0628'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 56
    rotation: 0
    state: enabled
- name: tx_amplitude
  id: variable
  parameters:
    comment: ''
    value: 10**(tx_power_dbm/20.0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1680
    - 56
    rotation: 0
    state: enabled
- name: warmup_bits
  id: variable
  parameters:
    comment: ''
    value: '4096'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 128
    rotation: 0
    state: enabled
- name: adaptive_tap_vectors_link
  id: virtual_sink
  parameters:
    alias: ''
    comment: ''
    stream_id: adaptive_tap_vectors
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1552
    - 544
    rotation: 0
    state: enabled
