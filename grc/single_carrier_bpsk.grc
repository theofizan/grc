- name: link_table
  id: snippet
  parameters:
    section: main_after_init
    priority: '1'
    code: "# Link budget and BER test as a spreadsheet-style table (display only).\n# Values come from stock Probe\
      \ Signal blocks; edit rows here to change it.\nrows = [\n    ('Transmit', 'Average power', self.probe_tx_dbm,\
      \ 'dBm', 'dB'),\n    ('', 'Sampled peak power', self.probe_tx_peak_dbm, 'dBm', 'dB'),\n    ('', 'Peak / average',\
      \ self.probe_tx_papr, 'dB', 'dB'),\n    ('Receive', 'Signal + noise power', self.probe_rx_dbm, 'dBm', 'dB'),\n\
      \    ('', 'SNR (noise over Fs)', self.probe_rx_snr, 'dB', 'dB'),\n    ('', 'Eb/N0 per uncoded bit', self.probe_rx_ebno,\
      \ 'dB', 'dB'),\n    ('', 'EVM (decision-directed)', self.probe_evm_rms, '%', 'dB'),\n    ('BER', 'Latest 10,000\
      \ bits', self.probe_ber_scale, 'errors/bit', 'ber'),\n    ('BER test', 'Test length', None, 'bits', \"f'{10000\
      \ * self.ber_test_blocks:,}'\"),\n    ('', 'Estimated time', None, 's', \"f'{self.ber_test_seconds:.2f}'\"\
      ),\n    ('', 'Status', self.probe_ber_test_count, '', 'status'),\n    ('', 'Bits compared', self.probe_ber_test_count,\
      \ 'bits', 'count'),\n    ('', 'Bit errors', self.probe_ber_test_errors, 'errors', 'count'),\n    ('', 'BER',\
      \ self.probe_ber_test_ratio, 'errors/bit', 'ber'),\n]\ntable = Qt.QTableWidget(len(rows), 4)\ntable.setHorizontalHeaderLabels([\"\
      Section\", \"Quantity\", \"Value\", \"Unit\"])\ntable.verticalHeader().setVisible(False)\ntable.setEditTriggers(Qt.QAbstractItemView.NoEditTriggers)\n\
      table.setSelectionMode(Qt.QAbstractItemView.NoSelection)\ntable.setAlternatingRowColors(True)\ntable.setShowGrid(True)\n\
      bold = Qt.QFont(table.font())\nbold.setBold(True)\nfor row, (section, quantity, probe, unit, fmt) in enumerate(rows):\n\
      \    for column, text in ((0, section), (1, quantity), (3, unit)):\n        item = Qt.QTableWidgetItem(text)\n\
      \        if column == 0:\n            item.setFont(bold)\n        table.setItem(row, column, item)\n    value\
      \ = Qt.QTableWidgetItem(\"\" if probe else str(eval(fmt)))\n    value.setTextAlignment(Qt.Qt.AlignRight |\
      \ Qt.Qt.AlignVCenter)\n    table.setItem(row, 2, value)\nheader = table.horizontalHeader()\nheader.setSectionResizeMode(Qt.QHeaderView.ResizeToContents)\n\
      header.setStretchLastSection(True)\ntest_bits = 10000 * self.ber_test_blocks\n\ndef refresh_link_table():\n\
      \    for row, (section, quantity, probe, unit, fmt) in enumerate(rows):\n        if probe is None:\n     \
      \       continue\n        level = probe.level()\n        if fmt == \"dB\":\n            text = f\"{level:.2f}\"\
      \n        elif fmt == \"count\":\n            text = f\"{level:,.0f}\"\n        elif fmt == \"ber\":\n   \
      \         text = f\"{level:.3e}\"\n        else:\n            text = \"complete\" if level >= test_bits else\
      \ (\n                \"counting\" if level > 0 else \"waiting for warm-up\")\n        table.item(row, 2).setText(text)\n\
      \nself.link_table = table\nself.link_table_timer = Qt.QTimer()\nself.link_table_timer.timeout.connect(refresh_link_table)\n\
      self.link_table_timer.start(int(1000 * self.plot_update_s))\nself.views_grid_layout_3.addWidget(table, 1,\
      \ 0, 2, 1)\n"
  states:
    coordinate:
    - 584
    - 248
    rotation: 0
    state: enabled
