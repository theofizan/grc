# direnv activates this project only after its contents have been explicitly allowed.
# Keep native GNU Radio/UHD tools available alongside the project's Python venv.
watch_file .venv/pyvenv.cfg
if [[ ! -r .venv/bin/activate ]]; then
    log_error 'Project environment is missing. See docs/ENVIRONMENT.md.'
    return 1
fi
PATH_add /Users/ofi/radioconda/bin
source .venv/bin/activate
