options:
  parameters:
    id: awgn_symbol_benchmark
    title: 'Uncoded BER and EVM: aligned symbol AWGN'
    author: Antenna benchmark project
    description: Exact uncoded-theory diagnostic with finite captures and external metrics. Not an 802.11 PHY.
    generate_options: no_gui
    output_language: python
    run_options: run
    catch_exceptions: 'True'
    run: 'True'
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: project_imports
  id: import
  parameters:
    imports: 'from antenna_bench.paths import ROOT

      from antenna_bench.math import make_symbols

      import math'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2200
    - 16
    rotation: 0
    state: enabled
- name: order
  id: parameter
  parameters:
    value: '16'
    type: intx
    label: Constellation order M
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 304
    rotation: 0
    state: enabled
- name: ebno_db
  id: parameter
  parameters:
    value: '8'
    type: eng_float
    label: Uncoded Eb/N0 (dB)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 304
    rotation: 0
    state: enabled
- name: symbol_count
  id: parameter
  parameters:
    value: '100000'
    type: intx
    label: Number of symbols
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 304
    rotation: 0
    state: enabled
- name: seed
  id: parameter
  parameters:
    value: '20261016'
    type: intx
    label: Noise/reference seed
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1560
    - 304
    rotation: 0
    state: enabled
- name: noise_voltage
  id: variable
  parameters:
    value: math.sqrt(1/(math.log2(order)*10**(ebno_db/10)))
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 528
    rotation: 0
    state: enabled
- name: reference_symbols
  id: blocks_vector_source_x
  parameters:
    type: complex
    vector: make_symbols(order, symbol_count, seed).tolist()
    repeat: 'False'
    vlen: '1'
    tags: '[]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 824
    rotation: 0
    state: enabled
- name: complex_awgn
  id: analog_noise_source_x
  parameters:
    type: complex
    noise_type: analog.GR_GAUSSIAN
    amp: noise_voltage
    seed: seed+1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 1104
    rotation: 0
    state: enabled
- name: add_noise
  id: blocks_add_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 1104
    rotation: 0
    state: enabled
- name: received_symbols
  id: blocks_file_sink
  parameters:
    type: complex
    file: str(ROOT / 'results/grc/symbol_rx.c64')
    append: 'False'
    vlen: '1'
    unbuffered: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 1104
    rotation: 0
    state: enabled
- name: transmitted_symbols
  id: blocks_file_sink
  parameters:
    type: complex
    file: str(ROOT / 'results/grc/symbol_tx.c64')
    append: 'False'
    vlen: '1'
    unbuffered: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 824
    rotation: 0
    state: enabled
- name: scope
  id: note
  parameters:
    note: 'UNCODED SYMBOL-RATE DIAGNOSTIC: perfect alignment, Es=1, no RF waveform or FEC.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 1496
    rotation: 0
    state: enabled
- name: noise
  id: note
  parameters:
    note: E|n|^2 = noise_voltage^2 = 1/(log2(M)*EbNo). Complex Gaussian convention is validated.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 1584
    rotation: 0
    state: enabled
- name: analysis
  id: note
  parameters:
    note: 'Run scripts/analyze_symbols.py then MATLAB validate_python_results(results/grc). See

      docs/FLOWGRAPHS.md.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 1672
    rotation: 0
    state: enabled
- name: layout_controls
  id: note
  parameters:
    note: RUN PARAMETERS
  states:
    coordinate:
    - 240
    - 240
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: layout_constants
  id: note
  parameters:
    note: DERIVED CONSTANTS
  states:
    coordinate:
    - 240
    - 480
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: layout_0
  id: note
  parameters:
    note: TRANSMIT REFERENCE
  states:
    coordinate:
    - 240
    - 752
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: layout_1
  id: note
  parameters:
    note: AWGN CHANNEL AND CAPTURE
  states:
    coordinate:
    - 240
    - 1032
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: layout_notes
  id: note
  parameters:
    note: MODEL ASSUMPTIONS AND OPERATING NOTES
  states:
    coordinate:
    - 240
    - 1432
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
connections:
- - reference_symbols
  - '0'
  - add_noise
  - '0'
- - complex_awgn
  - '0'
  - add_noise
  - '1'
- - reference_symbols
  - '0'
  - transmitted_symbols
  - '0'
- - add_noise
  - '0'
  - received_symbols
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
