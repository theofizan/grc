options:
  parameters:
    id: usrp_wifi_tx
    title: USRP legacy Wi-Fi transmit reference IQ
    author: Antenna benchmark project
    description: UHD hardware integration graph. RF/streaming, timed acquisition and antenna control require hardware
      commissioning.
    generate_options: no_gui
    output_language: python
    run_options: run
    catch_exceptions: 'True'
    run: 'True'
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: project_imports
  id: import
  parameters:
    imports: 'from antenna_bench.paths import ROOT

      from antenna_bench.math import make_symbols

      import math'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2200
    - 16
    rotation: 0
    state: enabled
- name: center_frequency
  id: parameter
  parameters:
    value: '5180000000.0'
    type: eng_float
    label: RF center frequency (Hz)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 304
    rotation: 0
    state: enabled
- name: gain_db
  id: parameter
  parameters:
    value: '0'
    type: eng_float
    label: USRP gain (dB)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 304
    rotation: 0
    state: enabled
- name: device_args
  id: parameter
  parameters:
    value: type=x300,addr=192.168.10.2
    type: str
    label: UHD device address
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 304
    rotation: 0
    state: enabled
- name: sample_rate
  id: variable
  parameters:
    value: 20e6
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 528
    rotation: 0
    state: enabled
- name: rate_index
  id: parameter
  parameters:
    value: '2'
    type: intx
    label: Legacy rate index (0-7)
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1560
    - 304
    rotation: 0
    state: enabled
- name: wifi_reference
  id: blocks_file_source
  parameters:
    type: complex
    file: str(ROOT / ('results/reference/wlan_rate_%d_tx.c64' % rate_index))
    repeat: 'False'
    vlen: '1'
    begin_tag: pmt.PMT_NIL
    offset: '0'
    length: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 824
    rotation: 0
    state: enabled
- name: usrp_sink
  id: uhd_usrp_sink
  parameters:
    type: fc32
    otw: sc16
    dev_addr: device_args
    dev_args: ''
    sync: none
    clock_source0: internal
    time_source0: ''
    sd_spec0: ''
    nchan: '1'
    samp_rate: sample_rate
    center_freq0: center_frequency
    gain0: gain_db
    ant0: '"TX/RX"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 824
    rotation: 0
    state: enabled
- name: scope
  id: note
  parameters:
    note: 'HARDWARE GRAPH: compiled only; not radio-tested. Configure actual daughterboard, addresses, ports

      and gains.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 1216
    rotation: 0
    state: enabled
- name: steering
  id: note
  parameters:
    note: Steer/await ready/settle BEFORE starting capture; keep beam fixed throughout every scored packet.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 1328
    rotation: 0
    state: enabled
- name: metadata
  id: note
  parameters:
    note: 'Standalone graph does not archive UHD errors/settings or enforce steering. Paper runs require the

      documented acquisition ledger.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 1416
    rotation: 0
    state: enabled
- name: layout_controls
  id: note
  parameters:
    note: RUN PARAMETERS
  states:
    coordinate:
    - 240
    - 240
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: layout_constants
  id: note
  parameters:
    note: DERIVED CONSTANTS
  states:
    coordinate:
    - 240
    - 480
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: layout_0
  id: note
  parameters:
    note: SISO TRANSMITTER
  states:
    coordinate:
    - 240
    - 752
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: layout_notes
  id: note
  parameters:
    note: MODEL ASSUMPTIONS AND OPERATING NOTES
  states:
    coordinate:
    - 240
    - 1152
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
connections:
- - wifi_reference
  - '0'
  - usrp_sink
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
